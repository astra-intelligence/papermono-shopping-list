# Copy to /etc/papermono-shopping-list.env (chmod 600) and fill in.

# "claude" to auto-sort new items into aisles with the Claude Code CLI, "none" to disable.
SHOPPING_LIST_CLASSIFIER=claude

# Full path to the claude binary if it isn't on the service's PATH.
#CLAUDE_BIN=/usr/local/bin/claude

# One of these authenticates the claude CLI. Don't set both: an API key takes precedence, so a
# placeholder value here silently breaks an otherwise working OAuth token.
#ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=

# The firmware version every PaperMono should be running. The matching image must be at
# /var/lib/papermono-shopping-list/firmware/<version>.bin. Leave unset to offer no updates.
# See docs/server.md#firmware-updates-ota.
#SHOPPING_LIST_FIRMWARE_VERSION=1.4.0
